---
import Layout from '../../../layouts/Layout.astro';
import ProgramaDetalle from '../../../components/ProgramaDetalle.astro';
import { getProgramSlugs, getProgramBySlug, getProgramAlternatePaths } from '../../../data/programas';

export function getStaticPaths() {
	return getProgramSlugs('en').map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lang = 'en';
const { tab, card, prevCard, nextCard } = getProgramBySlug(lang, slug)!;
---

<Layout
	lang={lang}
	title={`${card.title} | COE`}
	description={(card.description ?? tab.description)[0]}
	single
	alternatePaths={getProgramAlternatePaths(lang, slug)}
>
	<ProgramaDetalle lang={lang} tab={tab} card={card} prevCard={prevCard} nextCard={nextCard} />
</Layout>
