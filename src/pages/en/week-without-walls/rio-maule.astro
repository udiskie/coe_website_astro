---
import Layout from '../../../layouts/Layout.astro';
import WeekRioMaule from '../../../components/WeekRioMaule.astro';
import { rioMaule } from '../../../data/weekWithoutWalls';

const lang = 'en';
const content = rioMaule[lang];
---

<Layout
	lang={lang}
	title={`${content.title} | COE`}
	description={content.description}
	alternatePaths={{ es: '/week-without-walls/rio-maule', en: '/week-without-walls/rio-maule' }}
>
	<WeekRioMaule lang={lang} />
</Layout>
