---
import Layout from '../../layouts/Layout.astro';
import ProgramaDetalle from '../../components/ProgramaDetalle.astro';
import { getProgramSlugs, getProgramBySlug } from '../../data/programas';

export function getStaticPaths() {
	return getProgramSlugs('es').map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lang = 'es';
const { tab, card, prevCard, nextCard } = getProgramBySlug(lang, slug)!;
---

<Layout
	lang={lang}
	title={`${card.title} | COE`}
	description={tab.description[0]}
	single
	alternatePaths={{ es: `/programas/${slug}`, en: '/programs' }}
>
	<ProgramaDetalle lang={lang} tab={tab} card={card} prevCard={prevCard} nextCard={nextCard} />
</Layout>
