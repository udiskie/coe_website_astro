---
import { base, withBase } from '../utils/url';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const programasHref = localizedPath(lang, lang === 'es' ? '/programas' : '/programs').replace(/\/$/, '');
const galeriaHref = localizedPath(lang, lang === 'es' ? '/galeria' : '/gallery');
const presentacionCards = ['educativos', 'organizacional', 'aventura'] as const;
const presentacionImages = [
	withBase('/images/programas/programas-de-aventura-1.jpg'),
	withBase('/images/programas/galeria/incentivo-laboral/03.jpg'),
	withBase('/images/programas/galeria/maule-rio-abajo/02.jpg'),
];
const featuredProgramaHref = `${programasHref}/${t.aventura.featured.slug}`;
---

<div id="intro" class="cielo">
	<section
		id="home-hero-loading"
		class="fade-0 page-hero container-fluid vh-100 d-flex justify-content-end flex-column m-0 p-0 cielo-img"
	>
		<video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="auto"></video>

		<div class="intro-texto text-center text-lg-start">
			<h1 class="yellow-text fw-bold text-center text-lg-start">{t.hero.headline}</h1>
			<p class="yellow-text text-center text-lg-start mt-3 mb-4">{t.hero.subheading}</p>
			<a class="btn btn-primary black-button me-2 text-center text-sm-start d-inline-block" href={programasHref}>
				{t.hero.cta}
			</a>
		</div>
	</section>
</div>

<script is:inline define:vars={{ base }}>
	const heroLoading = document.querySelector('#home-hero-loading');
	setTimeout(() => {
		heroLoading?.classList.add('fadein');
	}, 200);

	const introTexto = document.querySelector('.intro-texto');
	setTimeout(() => {
		introTexto?.classList.add('intro-texto-slide');
	}, 300);

	window.addEventListener('scroll', () => {
		if (!introTexto) return;
		if (window.scrollY > introTexto.getBoundingClientRect().top / 3) {
			introTexto.classList.remove('intro-texto-slide');
		} else if (window.scrollY === 0) {
			introTexto.classList.add('intro-texto-slide');
		}
	});

	const heroVideos = [
		base + '/videos/hero/0_Durmitor_Montenegro_1280x720.mp4',
		base + '/videos/hero/0_Hiking_Forest_1280x720.mp4',
		base + '/videos/hero/1335373_Man_Boy_1280x720.mp4',
		base + '/videos/hero/5069123_Hiker_Caucasian_1280x720.mp4',
		base + '/videos/hero/5367223_Coll_wavebreak_Couple_1280x720.mp4',
		base + '/videos/hero/613715_Drone_Landscape_Drone_Mountains_1280x720.mp4',
		base + '/videos/hero/6506301_Hiking_Woman_1280x720.mp4',
		base + '/videos/hero/DJI_0909_1280x720.mp4',
		base + '/videos/hero/DJI_0933_1280x720.mp4',
	];
	// Shuffle once so the hero and the aventura background never show the same clip.
	const shuffled = [...heroVideos];
	for (let i = shuffled.length - 1; i > 0; i--) {
		const j = Math.floor(Math.random() * (i + 1));
		[shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
	}
	// This script runs before the sections below are parsed, so wait for the DOM before looking them up.
	const assignVideos = () => {
		[document.querySelector('#hero-video'), document.querySelector('#aventura-video')].forEach((el, i) => {
			if (!el) return;
			el.src = shuffled[i];
			el.play().catch(() => {});
		});
	};
	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', assignVideos);
	else assignVideos();

	// The intro block is 1.5x as tall as its content needs; text stays vertically centered.
	const scaleAventuraIntro = () => {
		const intro = document.querySelector('.aventura-intro');
		if (!intro) return;
		intro.style.minHeight = '';
		intro.style.minHeight = `${intro.offsetHeight * 1.5}px`;
	};
	document.addEventListener('DOMContentLoaded', scaleAventuraIntro);
	addEventListener('load', scaleAventuraIntro);
	addEventListener('resize', scaleAventuraIntro);
</script>

<section
	id="presentacion"
	class="container-fluid d-flex py-5 align-items-center justify-content-start presentacion container-fluid hero-overlap"
>
	<div class="container mt-5 pt-5">
		<div class="presentacion-group" data-presentacion-group>
		<div class="presentacion-title"><span class="chip-badge mb-3">{t.presentacion.badge}</span><h2 class="text-center fw-semibold mb-0 reveal">{t.presentacion.heading}</h2></div>
		<div class="presentacion-stack" data-presentacion-stack style={`--n: ${presentacionCards.length}`}>
			{
				presentacionCards.map((key, i) => (
					<div class="presentacion-card-wrap" style={`--i: ${i}`}>
						<article class="presentacion-card">
							<div class="presentacion-card-media">
								<img src={presentacionImages[i]} alt={t.presentacion[key].alt} loading="lazy" decoding="async" />
							</div>
							<div class="presentacion-card-body">
								<h3>{t.presentacion[key].title}</h3>
								<p>{t.presentacion[key].description}</p>
							</div>
						</article>
					</div>
				))
			}
		</div>
		<div class="mb-5 d-flex justify-content-center reveal" data-presentacion-cta>
			<a class="btn btn-outline-primary my-3 brown-button me-2 text-center" href={programasHref}>
				{t.presentacion.cta}
			</a>
		</div>
		</div>
	</div>
</section>

<section
	id="programas"
	class="container-fluid vh-lg-50 d-flex p-0 flex-column align-items-center justify-content-start programas"
>
	<div class="container-fluid reveal">
		<div class="row p-0 h-100 d-flex flex-column-reverse flex-lg-row">
			<div class="col-lg-6 p-0 d-flex flex-column align-items-center justify-content-center">
				<div class="py-5 px-0 px-sm-5 d-flex flex-column align-items-center align-items-lg-start justify-content-center w-75">
					<h2 class="text-center text-lg-start mb-3">{t.servicios.heading}</h2>
					<p class="text-center text-lg-start mb-0 mb-lg-3">{t.servicios.subheading}</p>
					<a
						class="btn btn-primary mt-5 my-lg-3 black-button me-2 text-center text-sm-start d-block"
						href={galeriaHref}
					>
						{t.servicios.cta}
					</a>
				</div>
			</div>
			<div class="col-lg-6 p-8 h-100">
				<div id="carousel-servicios" class="carousel slide h-100" data-bs-ride="false" style="border-radius: 16px; overflow: hidden;">
					<div class="carousel-indicators">
						{
							t.servicios.slides.map((_, i) => (
								<button
									type="button"
									data-bs-target="#carousel-servicios"
									data-bs-slide-to={i}
									class:list={[{ active: i === 0 }]}
									aria-current={i === 0 ? 'true' : undefined}
									aria-label={`Slide ${i + 1}`}
								/>
							))
						}
					</div>
					<div class="carousel-inner h-100">
						{
							t.servicios.slides.map((slide, i) => (
								<div class:list={['carousel-item', { active: i === 0 }]} data-bs-interval="3000">
									<div class="d-flex justify-content-center overflow-hidden">
										<img src={slide.src} class="d-block w-100" alt={slide.alt} />
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<section id="aventura" class="container-fluid d-flex p-0 flex-column align-items-center">
	<div class="d-flex p-8 flex-column align-items-center justify-content-center aventura-intro w-100">
		<video id="aventura-video" class="aventura-intro-video" autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
		<h2 class="text-center text-lg-start mt-5 mb-3">{t.aventura.heading}</h2>
		<p class="text-center text-lg-start mb-5">{t.aventura.subheading}</p>
	</div>
	<div class="proximas-aventuras reveal">
		<div>
			<div
				id="carousel-aventuras"
				class="carousel slide h-100 home-slider fade-0"
				data-bs-ride="carousel"
				data-bs-touch="true"
			>
				<div class="carousel-indicators"></div>

				<div class="carousel-inner w-100">
					<div class="carousel-item active">
						<div class="row px-0">
							<div class="col-lg-6 p-8 d-flex justify-content-center overflow-hidden">
								<img style="border-radius: 16px; aspect-ratio: 1200 / 844; object-fit: cover; object-position: center;"
									width="1016"
									height="844"
									src={t.aventura.featured.image}
									class="d-block w-100 h-auto"
									alt=""
									decoding="async"
									fetchpriority="high"
									srcset={t.aventura.featured.imageSrcset}
									sizes="(max-width: 1016px) 100vw, 1016px"
								/>
							</div>

							<div class="col-lg-6 p-0 d-flex flex-column align-items-center justify-content-center">
								<div class="py-5 px-0 px-sm-5 d-flex flex-column align-items-center align-items-lg-start justify-content-center w-75">
									<div>
										<h3 class="text-center text-lg-start mb-3">{t.aventura.featured.title}</h3>
										<p class="text-center text-lg-start mb-0 mb-lg-3">
											{t.aventura.featured.description}
										</p>
									</div>
									<div>
										<a
											class="btn btn-primary my-3 black-button me-2 text-center text-sm-start"
											href={featuredProgramaHref}
										>
											{t.aventura.featured.cta}
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script is:inline src={withBase('/assets/js/hero_home.js')}></script>

<script>
	// The title stays pinned above the stack, so the cards must stick below it.
	const group = document.querySelector<HTMLElement>('[data-presentacion-group]');
	const title = group?.querySelector<HTMLElement>('.presentacion-title');
	if (group && title) {
		const setTitleHeight = () => group.style.setProperty('--title-h', `${title.offsetHeight}px`);
		setTitleHeight();
		new ResizeObserver(setTitleHeight).observe(title);

		// When the stack's end releases the cards, carry the title up with them so the final
		// layout (title, cards at their offsets, button) scrolls away as a static block.
		const firstWrap = group.querySelector<HTMLElement>('.presentacion-card-wrap');
		if (firstWrap) {
			let titleTicking = false;
			const followStack = () => {
				titleTicking = false;
				title.style.transform = '';
				// The title never sits lower than just above the first card, wherever the cards end up.
				const target = firstWrap.getBoundingClientRect().top - title.offsetHeight;
				const current = title.getBoundingClientRect().top;
				if (target < current) title.style.transform = `translateY(${target - current}px)`;
			};
			const onTitleScroll = () => {
				if (!titleTicking) {
					titleTicking = true;
					requestAnimationFrame(followStack);
				}
			};
			addEventListener('scroll', onTitleScroll, { passive: true });
			addEventListener('resize', onTitleScroll);
			followStack();
		}
	}

	const stack = document.querySelector<HTMLElement>('[data-presentacion-stack]');
	if (stack && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const wraps = Array.from(stack.querySelectorAll<HTMLElement>('.presentacion-card-wrap'));
		const images = wraps.map((w) => w.querySelector<HTMLElement>('.presentacion-card-media img')!);
		const clamp = (n: number, min = 0, max = 1) => Math.min(max, Math.max(min, n));
		const cta = document.querySelector('[data-presentacion-cta]');
		const styles = getComputedStyle(stack);
		const step = parseFloat(styles.getPropertyValue('--step')) || 64;
		const gap = parseFloat(styles.rowGap) || 0;
		let ticking = false;
		let paused = false;

		function update() {
			ticking = false;
			const vh = innerHeight;
			wraps.forEach((_, i) => {
				const rect = wraps[i].getBoundingClientRect();
				// How far the next card has slid over this one (0 = not yet, 1 = fully stacked).
				// Always tracked, even while the parallax is frozen, so the last card's stacking still finishes the effect.
				const next = wraps[i + 1];
				const full = rect.height + gap;
				const covered = next ? clamp((full - (next.getBoundingClientRect().top - rect.top)) / (full - step)) : 0;
				wraps[i].style.setProperty('--covered', covered.toFixed(3));
				if (paused) return;
				const center = (rect.top + rect.height / 2) / vh;
				images[i].style.transform = `translateY(${clamp((0.5 - center) * 80, -56, 56)}px)`;
			});
		}
		function onScroll() {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		}
		// Freeze the effects while the button below the stack is on screen; resume when it leaves.
		if (cta) {
			new IntersectionObserver(([entry]) => {
				if (entry.isIntersecting && !paused) {
					update();
					paused = true;
				} else if (!entry.isIntersecting && paused) {
					paused = false;
					update();
				}
			}).observe(cta);
		}
		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', onScroll);
		update();
	}
</script>
