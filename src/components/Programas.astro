---
import type { Lang } from '../i18n/ui';
import { programasContent } from '../data/programas';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const content = programasContent[lang];
---

<section
	id="page-hero"
	class="page-hero pg-template page-hero-interna position-relative overflow-hidden d-flex justify-content-center align-items-center"
>
	<img id="page-hero-img" class="position-absolute fade-0 pg-hero-fix-mobile" src={content.heroImage} />
	<div class="d-flex justify-content-center align-items-center h-100 w-100 position-absolute">
		<div><h1 class="fw-bolder page-hero-title">{content.heroTitle}</h1></div>
	</div>
</section>

<section id="to_tab" class="yellow-bkgnd">
	<div class="container">
		<div class="d-flex justify-content-center py-3 py-lg-5 align-items-center">
			<ul
				class="nav row nav-pills m-0 d-flex w-100 align-items-center justify-content-center justify-content-lg-between px-3 px-lg-0"
				id="programas-tab"
				role="tablist"
			>
				{
					content.tabs.map((tab, i) => (
						<li class="nav-item col-lg-4 d-flex justify-content-center" role="presentation">
							<button
								class:list={['nav-link p-0 programas-menu fs-4 my-2 m-lg-0', { active: i === 0 }]}
								id={`${tab.id}-tab`}
								data-bs-toggle="pill"
								data-bs-target={`#${tab.id}`}
								type="button"
								role="tab"
								aria-controls={tab.id}
								aria-selected={i === 0 ? 'true' : 'false'}
							>
								{tab.label}
							</button>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<section>
	<div class="tab-content programas-tab-container conatiner-fluid" id="programas-tabContent">
		{
			content.tabs.map((tab, i) => (
				<div
					class:list={['tab-pane fade show', { active: i === 0 }]}
					id={tab.id}
					role="tabpanel"
					aria-labelledby={`${tab.id}-tab`}
					tabindex="0"
				>
					<div class="yellow-bkgnd-light container-fluid">
						<div class="container d-flex flex-column align-items-center py-5">
							<div>
								<h2 class="mb-5 fw-bold">{tab.heading}</h2>
							</div>
							<div class="text-center w-75">
								{tab.description.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						</div>
					</div>
					<div class="container">
						<div class="row my-5 d-flex justify-content-center">
							{tab.cards.map((card) => (
								<div class="col-lg-4 mb-4">
									<a href={card.href}>
										<div class="position-relative fade-0">
											<div class="postition-absolute programa-thumbnail-img">
												<img
													width={card.imageWidth}
													height={card.imageHeight}
													src={card.image}
													class="w-100 h-auto"
													alt=""
													decoding="async"
													srcset={card.imageSrcset}
													sizes={`(max-width: ${card.imageWidth}px) 100vw, ${card.imageWidth}px`}
												/>
											</div>
											<div class="position-absolute programa-caption p-4 fs-5 w-100">
												<h3>{card.title}</h3>
											</div>
										</div>
									</a>
								</div>
							))}
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>
