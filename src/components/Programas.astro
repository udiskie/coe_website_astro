---
import type { Lang } from '../i18n/ui';
import { programasContent } from '../data/programas';
import { localizedPath } from '../i18n/utils';
import ThumbnailCard from './ThumbnailCard.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const content = programasContent[lang];
const basePath = localizedPath(lang, lang === 'es' ? '/programas' : '/programs').replace(/\/$/, '');
import { heroImages } from '../data/heroes';
import HeroRandomBg from './HeroRandomBg.astro';
---

<section
	id="page-hero"
	class="page-hero pg-template page-hero-interna fade-0 overflow-hidden d-flex justify-content-center align-items-center"
	style={`background-image: url('${heroImages[0]}');`}
>
	<div class="d-flex justify-content-center align-items-center h-100 w-100 position-absolute">
		<div><h1 class="fw-bolder page-hero-title">{content.heroTitle}</h1></div>
	</div>
	<HeroRandomBg />
</section>

<section class="programas-overview hero-overlap">
	<div class="container programas-container">
		<div class="d-flex flex-column align-items-center text-center py-5">
			<span class="chip-badge mb-4">{content.badge}</span>
			<h4 class="fw-bold mb-3">{content.heading}</h4>
			<p class="fst-italic w-75 mb-0">{content.subheading}</p>
		</div>

		{
			content.tabs.map((tab) => (
				<div class="programa-category mb-5" id={tab.id}>
					<div class="mb-4">
						<h5 class="text-center text-lg-start fw-bold">{tab.heading}</h5>
						{tab.description.map((paragraph) => (
							<p class="fst-italic text-center text-lg-start">{paragraph}</p>
						))}
					</div>
					<div class="row g-4">
						{tab.cards.map((card) => (
							<div class="col-md-6 col-lg-3">
								<ThumbnailCard
										href={`${basePath}/${card.slug}`}
										image={card.image}
										title={card.title}
										width={card.imageWidth}
										height={card.imageHeight}
										srcset={card.imageSrcset}
										sizes={`(max-width: ${card.imageWidth}px) 100vw, ${card.imageWidth}px`}
									/>
							</div>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>
