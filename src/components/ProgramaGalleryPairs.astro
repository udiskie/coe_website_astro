---
import { withBase } from '../utils/url';

interface Props {
	title: string;
	images: string[];
	/** Images shown per page. */
	perPage?: number;
}

const { title, images, perPage = 2 } = Astro.props;
const pages: string[][] = [];
for (let i = 0; i < images.length; i += perPage) pages.push(images.slice(i, i + perPage));
const hasMultiple = pages.length > 1;
---

<div class="container">
	<div class="programa-pairs" data-programa-pairs>
		<div class="programa-pairs-viewport">
			<div class="programa-pairs-track">
				{
					pages.map((page, p) => (
						<div class="programa-pairs-page" aria-hidden={p === 0 ? 'false' : 'true'}>
							{page.map((src) => (
								<img
									src={withBase(src)}
									alt={title}
									class="programa-pairs-img"
									decoding="async"
									loading={p === 0 ? 'eager' : 'lazy'}
								/>
							))}
						</div>
					))
				}
			</div>
		</div>

		{
			hasMultiple && (
				<>
					<button type="button" class="programa-gallery-arrow programa-gallery-prev" aria-label="Anterior">
						‹
					</button>
					<button type="button" class="programa-gallery-arrow programa-gallery-next" aria-label="Siguiente">
						›
					</button>
					<div class="programa-gallery-dots programa-pairs-dots">
						{pages.map((_, i) => (
							<button
								type="button"
								class:list={['programa-gallery-dot', { active: i === 0 }]}
								aria-label={`Ir a la página ${i + 1}`}
							/>
						))}
					</div>
				</>
			)
		}
	</div>
</div>

<script>
	function initProgramaPairs() {
		document.querySelectorAll<HTMLElement>('[data-programa-pairs]').forEach((root) => {
			const track = root.querySelector<HTMLElement>('.programa-pairs-track');
			const pages = Array.from(root.querySelectorAll<HTMLElement>('.programa-pairs-page'));
			if (!track || pages.length <= 1) return;

			const dots = Array.from(root.querySelectorAll<HTMLElement>('.programa-gallery-dot'));
			let current = 0;
			let timer: ReturnType<typeof setInterval> | undefined;

			function goTo(index: number) {
				current = (index + pages.length) % pages.length;
				track!.style.transform = `translateX(-${current * 100}%)`;
				pages.forEach((el, i) => el.setAttribute('aria-hidden', String(i !== current)));
				dots.forEach((el, i) => el.classList.toggle('active', i === current));
			}
			function startAutoplay() {
				stopAutoplay();
				timer = setInterval(() => goTo(current + 1), 6000);
			}
			function stopAutoplay() {
				if (timer) clearInterval(timer);
			}

			root.querySelector('.programa-gallery-prev')?.addEventListener('click', () => {
				goTo(current - 1);
				startAutoplay();
			});
			root.querySelector('.programa-gallery-next')?.addEventListener('click', () => {
				goTo(current + 1);
				startAutoplay();
			});
			dots.forEach((dot, i) =>
				dot.addEventListener('click', () => {
					goTo(i);
					startAutoplay();
				})
			);

			// Swipe on touch devices.
			let startX = 0;
			root.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
			root.addEventListener('touchend', (e) => {
				const dx = e.changedTouches[0].clientX - startX;
				if (Math.abs(dx) < 40) return;
				goTo(current + (dx < 0 ? 1 : -1));
				startAutoplay();
			});

			root.addEventListener('mouseenter', stopAutoplay);
			root.addEventListener('mouseleave', startAutoplay);
			startAutoplay();
		});
	}

	initProgramaPairs();
</script>
