---
import type { Lang } from '../i18n/ui';
import { rioMaule } from '../data/weekWithoutWalls';
import { withBase } from '../utils/url';
import ProgramaGallery from './ProgramaGallery.astro';
import { programasContent } from '../data/programas';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const content = rioMaule[lang];
const heroImage = withBase('/images/hero/programas.jpg');
// Same photos as the Maule River program page.
const maule = programasContent.en.tabs.flatMap((tab) => tab.cards).find((card) => card.slug === 'maule-river')!;
---

<section
	id="page-hero"
	class="page-hero pg-template page-hero-interna fade-0 overflow-hidden d-flex justify-content-center align-items-center"
	style={`background-image: url('${heroImage}');`}
>
	<div class="d-flex justify-content-center align-items-center h-100 w-100 position-absolute">
		<div><h1 class="fw-bolder page-hero-title">{content.heroTitle}</h1></div>
	</div>
</section>

<section class="programas-overview hero-overlap">
	<div class="container programas-container py-5">
		<div class="d-flex flex-column align-items-center text-center mt-4 mb-4 programa-detalle-single">
			<h4 class="fw-bold mb-5">{content.title}</h4>

			<p class="programa-detalle-text mx-auto">{content.description}</p>

			<div class="programa-detalle-text mx-auto mt-4 text-start w-100">
				<ul class="mb-0">
					{content.details.map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<div class="d-flex flex-row flex-wrap justify-content-center gap-3 mt-4">
				<a
					href={content.programUrl}
					class="btn btn-outline-primary black-button programa-detalle-cta text-center"
					target="_blank"
					rel="noopener"
				>
					{content.programLabel}
				</a>
				<a
					href={content.equipmentUrl}
					class="btn btn-outline-primary black-button programa-detalle-cta text-center"
					target="_blank"
					rel="noopener"
				>
					{content.equipmentLabel}
				</a>
			</div>

			<div class="w-100 mt-7">
				<ProgramaGallery lang={lang} title={content.title} image={maule.image} gallery={maule.gallery} />
			</div>
		</div>
	</div>
</section>
