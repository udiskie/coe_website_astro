---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	isHome?: boolean;
	/** Renders the header opaque from the start, for pages with no hero banner behind it. */
	single?: boolean;
	/** Path (no locale prefix) of the equivalent page in each language, for hreflang alternates. */
	alternatePaths?: { es: string; en: string };
}

const {
	lang,
	title,
	description,
	isHome = false,
	single = false,
	alternatePaths = { es: '/', en: '/' },
} = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
---

<!doctype html>
<html lang={t.html_lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="initial-scale=1, maximum-scale=1, user-scalable=no, width=device-width" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="robots" content="max-image-preview:large" />

		<link rel="alternate" href={localizedPath('en', alternatePaths.en)} hreflang="en" />
		<link rel="alternate" href={localizedPath('es', alternatePaths.es)} hreflang="es" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<link rel="icon" type="image/x-icon" href="/favicon.ico" />

		<link rel="stylesheet" href="/assets/css/theme.css" />
		<link rel="stylesheet" href="/assets/css/coe-child.css" />

		<!-- Google tag (gtag.js) -->
		<script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-L884EG6TK5"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-L884EG6TK5');
		</script>
	</head>
	<body class:list={{ home: isHome }}>
		<div id="wrapper" class="min-height d-flex flex-column justify-content-between">
			<Header lang={lang} isHome={isHome} single={single} alternatePaths={alternatePaths} />
			<main id="main" class="container-fluid m-0 p-0">
				<slot />
			</main>
			<Footer lang={lang} />
		</div>

		<script is:inline src="/assets/js/main.bundle.js"></script>
		<script is:inline src="/assets/js/my_scripts.js"></script>
	</body>
</html>
